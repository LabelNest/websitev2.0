# Neon DB — same project as DataNest/NestLens
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secret for admin panel — generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-jwt-secret-here

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=labelnest
R2_PUBLIC_URL=https://assets.labelnest.in

# Site
NEXT_PUBLIC_SITE_URL=https://labelnest.in

# Brevo — admin panel newsletter sending (transactional email API)
BREVO_API_KEY=your-brevo-api-key-here
