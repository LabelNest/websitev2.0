# Neon DB — same project as DataNest/NestLens
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secret for admin panel — generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-jwt-secret-here

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=labelnest
R2_PUBLIC_URL=https://assets.labelnest.in

# Site
NEXT_PUBLIC_SITE_URL=https://labelnest.in

# Brevo — admin panel newsletter sending (bulk BCC). NOT the shared
# email-service below — that's single-recipient transactional only, bulk
# newsletter sending hasn't been migrated onto it yet.
BREVO_API_KEY=your-brevo-api-key-here

# email-service — shared microservice (AWS SES), used for the contact form's
# notification to contact@labelnest.in. Same EMAIL_SERVICE_KEY value as every
# other repo calling this service.
EMAIL_SERVICE_URL=https://email-service.labelnest.in
EMAIL_SERVICE_KEY=your-email-service-key-here

# Sarvam — Kai marketing chat widget (/api/kai). LabelNest is a Sarvam
# partner; same key used across DataNest/NestLens/NestIntel.
SARVAM_API_KEY=your-sarvam-api-key-here
